# Plantilla de variables de entorno — COPIAR a .env y rellenar con valores reales.
# NUNCA poner credenciales reales en este archivo (este sí se versiona).
# El archivo .env real está ignorado por git.

# Supabase (proyecto propio)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Correo del Super Admin maestro (no se hardcodea en el código).
# Sin esta variable no hay admin maestro y el acceso privilegiado falla seguro.
VITE_MASTER_ADMIN=tu-correo-admin@ejemplo.com

# Clave del Super Admin principal (no se hardcodea en el código)
VITE_SUPER_ADMIN_PASSWORD=define-una-clave-fuerte
